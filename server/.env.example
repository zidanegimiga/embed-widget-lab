NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Origins of the HMIS sites allowed to embed the widget, comma-separated (* allows any)
ALLOWED_ORIGINS=*

# Leave unset to skip token checks (local dev only)
# WIDGET_TOKEN=demo-token

# Leave unset to use the fake event generator
# RABBITMQ_URL=amqp://user:pass@localhost:5672
RABBITMQ_EXCHANGE=hmis.events
FAKE_EVENT_INTERVAL_MS=4000

# Reverse proxies in front of the server (1 on Render). Needed for per-IP rate limits.
TRUST_PROXY=0
# Ingest requests per minute per client IP
INGEST_RATE_LIMIT=30

# Server-to-server key the HMIS uses for POST /events (min 16 chars, required in production)
# INGEST_API_KEY=
