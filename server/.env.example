NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Origins of the HMIS sites allowed to embed the widget, comma-separated (* allows any)
ALLOWED_ORIGINS=*

# Leave unset to skip token checks (local dev only)
# WIDGET_TOKEN=demo-token

# Leave unset to use the fake event generator
# RABBITMQ_URL=amqp://user:pass@localhost:5672
RABBITMQ_EXCHANGE=hmis.events
FAKE_EVENT_INTERVAL_MS=4000
