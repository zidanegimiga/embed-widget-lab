# Copy to .env. Used by docker compose.
RABBITMQ_USER=widget
RABBITMQ_PASSWORD=change-me

# Shared secret between the server and the embed snippet
WIDGET_TOKEN=change-me

# Public URLs of each deployed piece
SERVER_URL=http://localhost:4000
WIDGET_URL=http://localhost:4100

# HMIS origins allowed to connect, comma-separated
ALLOWED_ORIGINS=http://localhost:5050
